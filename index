<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="dark">
<title>Plan de Crecimiento 90 días · Diana Jaramillo × Bresco Media</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#02060F;--ink:#EAF4FF;--muted:#9DB4CC;--blue:#1BA3E8;--blue-d:#0B5E9E;--card:rgba(255,255,255,.045);--line:rgba(27,163,232,.28);
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#02060F}}
:root[data-theme="dark"]{--bg:#02060F}
*,*::before,*::after{box-sizing:border-box}
html{color-scheme:dark;scroll-behavior:smooth;scroll-padding-top:calc(72px + env(safe-area-inset-top,0px))}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.6 Manrope,system-ui,sans-serif;overflow-x:hidden}
h1,h2,h3{font-family:"Instrument Serif",Georgia,serif;font-weight:400;line-height:1.05;margin:0;letter-spacing:-.01em}
h1{font-size:clamp(2.8rem,13vw,4.8rem)}
h2{font-size:clamp(2.2rem,9vw,3.2rem);text-align:center}
h3{font-size:1.5rem}
p{margin:0}
b.hl,.hl{color:var(--blue);font-style:italic}
:focus-visible{outline:3px solid var(--blue);outline-offset:3px}
/* fondo azul en movimiento */
.bg{position:fixed;inset:0;z-index:-1;overflow:hidden;background:radial-gradient(120% 80% at 50% 0%,#06223F 0%,var(--bg) 60%)}
.bg i{position:absolute;border-radius:50%;filter:blur(70px);opacity:.55;will-change:transform}
.bg i:nth-child(1){width:70vmax;height:70vmax;left:-25vmax;top:-20vmax;background:#0B7BC4;animation:d1 18s ease-in-out infinite alternate}
.bg i:nth-child(2){width:55vmax;height:55vmax;right:-25vmax;top:25vh;background:#1BA3E8;opacity:.35;animation:d2 24s ease-in-out infinite alternate}
.bg i:nth-child(3){width:60vmax;height:60vmax;left:-10vmax;bottom:-30vmax;background:#0A3F7A;animation:d3 21s ease-in-out infinite alternate}
.bg::after{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(27,163,232,.07) 1px,transparent 1px),linear-gradient(90deg,rgba(27,163,232,.07) 1px,transparent 1px);background-size:38px 38px;animation:grid 14s linear infinite;mask-image:linear-gradient(#000,transparent 85%)}
@keyframes d1{to{transform:translate(18vmax,14vmax) scale(1.15)}}
@keyframes d2{to{transform:translate(-22vmax,-12vmax) scale(.9)}}
@keyframes d3{to{transform:translate(20vmax,-14vmax) scale(1.2)}}
@keyframes grid{to{background-position:38px 38px,38px 38px}}
@media (prefers-reduced-motion:reduce){.bg i,.bg::after{animation:none}html{scroll-behavior:auto}}
/* layout */
.wrap{max-width:560px;margin:0 auto;padding:0 20px}
@media (min-width:860px){.wrap{max-width:980px}}
section{padding:64px 0}
.sub{color:var(--muted);text-align:center;margin:12px auto 30px;max-width:44ch;font-size:.95rem}
/* nav */
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:rgba(2,6,15,.72);backdrop-filter:blur(12px);border-bottom:1px solid rgba(27,163,232,.15)}
.nav{display:flex;align-items:center;justify-content:space-between;height:62px}
.logo{font:400 1.6rem "Instrument Serif",Georgia,serif;text-decoration:none}
.logo span{color:var(--blue)}
.btn{display:inline-flex;align-items:center;justify-content:center;padding:13px 26px;border-radius:999px;font:600 .95rem Manrope,sans-serif;text-decoration:none;color:#fff;background:linear-gradient(90deg,var(--blue-d),var(--blue));box-shadow:0 0 24px rgba(27,163,232,.35);border:1px solid transparent;transition:transform .2s,box-shadow .2s;cursor:pointer}
.btn:hover{transform:translateY(-2px);box-shadow:0 0 34px rgba(27,163,232,.6)}
.btn.ghost{background:transparent;border-color:var(--line);box-shadow:none}
.btn.sm{padding:9px 18px;font-size:.85rem}
/* hero */
.hero{padding:56px 0 40px}
.hero p.lead{color:var(--muted);margin:18px 0 26px;max-width:40ch}
.who{font-size:.9rem;color:var(--blue);margin-bottom:14px}
.btns{display:flex;gap:12px;flex-wrap:wrap}
.chips{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:34px}
.chip{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:14px 8px;text-align:center}
.chip b{display:block;font:400 2.5rem "Instrument Serif",Georgia,serif;color:var(--blue)}
.chip span{font-size:.78rem;color:var(--muted)}
/* tarjetas */
.grid{display:grid;gap:14px}
@media (min-width:700px){.grid.c3{grid-template-columns:repeat(3,1fr)}}
.card{background:var(--card);border:1px solid rgba(27,163,232,.16);border-radius:18px;padding:22px;transition:border-color .25s,transform .25s}
.card:hover{border-color:var(--blue);transform:translateY(-3px)}
.card p{color:var(--muted);font-size:.93rem;margin-top:8px}
.ico{width:44px;height:44px;border-radius:12px;border:1px solid var(--line);display:grid;place-items:center;margin-bottom:14px;background:rgba(27,163,232,.08)}
.ico svg{width:22px;height:22px;stroke:var(--blue);fill:none;stroke-width:1.7}
/* pruebas */
details{background:var(--card);border:1px solid rgba(27,163,232,.16);border-radius:16px;padding:16px 18px}
details+details{margin-top:10px}
summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:12px;font:600 1.02rem Manrope,sans-serif}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";color:var(--blue);font-size:1.4rem;line-height:1;transition:transform .25s}
details[open]{border-color:var(--blue)}
details[open] summary::after{transform:rotate(45deg)}
details p{color:var(--muted);font-size:.93rem;margin-top:10px}
details p b{color:var(--ink);font-weight:500}
/* fases */
.tl{position:relative;padding-left:26px}
.tl::before{content:"";position:absolute;left:7px;top:6px;bottom:6px;width:2px;background:linear-gradient(var(--blue),transparent)}
.ph{position:relative;margin-bottom:16px}
.ph::before{content:"";position:absolute;left:-26px;top:22px;width:16px;height:16px;border-radius:50%;background:var(--bg);border:3px solid var(--blue);box-shadow:0 0 14px var(--blue)}
.ph small{color:var(--blue);font-size:.82rem}
/* decisiones */
.dec{display:flex;gap:16px;align-items:center}
.date{flex:none;width:64px;text-align:center;border-right:1px solid var(--line);padding-right:14px}
.date b{display:block;font:400 2.3rem "Instrument Serif",Georgia,serif;color:var(--blue);line-height:1}
.date span{font-size:.75rem;color:var(--muted)}
/* metricas */
.tags{display:flex;flex-wrap:wrap;gap:8px;justify-content:center}
.tags span{border:1px solid var(--line);background:rgba(27,163,232,.07);border-radius:999px;padding:8px 14px;font-size:.88rem}
.list{margin:0;padding:0;list-style:none;display:grid;gap:10px}
.list li{display:flex;gap:12px;color:var(--muted);font-size:.95rem}
.list li::before{content:"";flex:none;width:18px;height:18px;margin-top:3px;border-radius:50%;border:1.5px solid var(--blue);background:radial-gradient(circle,var(--blue) 32%,transparent 36%)}
/* precio */
.price{max-width:460px;margin:0 auto;background:linear-gradient(180deg,rgba(27,163,232,.14),rgba(255,255,255,.03));border:1px solid var(--blue);border-radius:24px;padding:30px 24px;text-align:center;position:relative;box-shadow:0 0 50px rgba(27,163,232,.2)}
.price .flag{position:absolute;top:-14px;left:50%;transform:translateX(-50%);background:var(--blue);color:#02060F;font:700 .75rem Manrope,sans-serif;letter-spacing:.06em;padding:5px 16px;border-radius:99px;white-space:nowrap}
.old{color:var(--muted);text-decoration:line-through;font-size:1.1rem;margin-top:8px}
.now{font:400 clamp(3.8rem,19vw,5.2rem) "Instrument Serif",Georgia,serif;line-height:1;margin:2px 0}
.now small{font:400 1rem Manrope,sans-serif;color:var(--muted)}
.cd{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:22px 0 8px}
.cd div{background:rgba(2,6,15,.6);border:1px solid var(--line);border-radius:12px;padding:10px 0}
.cd b{display:block;font:400 2rem "Instrument Serif",Georgia,serif;font-variant-numeric:tabular-nums}
.cd span{font-size:.7rem;color:var(--muted)}
.note{font-size:.82rem;color:var(--muted);margin-top:14px}
.price .list{text-align:left;margin:22px 0}
.price .btn{width:100%}
/* cierre */
.final{text-align:center}
.final .btn{margin-top:22px}
footer{padding:30px 0 40px;text-align:center;color:var(--muted);font-size:.8rem;border-top:1px solid rgba(27,163,232,.15)}
</style>
</head>
<body>
<div class="bg" aria-hidden="true"><i></i><i></i><i></i></div>

<header><div class="wrap nav">
<a class="logo" href="#inicio">Bresco<span>Media</span></a>
<a class="btn sm" href="#precio">Aprobar plan</a>
</div></header>

<main id="inicio">
<section class="hero"><div class="wrap">
<p class="who">Para Diana Jaramillo Real Estate Broker</p>
<h1>Plan de Crecimiento <span class="hl">90 días</span></h1>
<p class="lead">Sabrá con datos si la publicidad le trae clientes reales, y lo decide usted en tres fechas. Arranque: lunes 30 de noviembre.</p>
<div class="btns"><a class="btn" href="#plan">Ver el plan</a><a class="btn ghost" href="#precio">Ver la inversión</a></div>
<div class="chips">
<div class="chip"><b>12</b><span>semanas</span></div>
<div class="chip"><b>3</b><span>decisiones</span></div>
<div class="chip"><b>1</b><span>tablero en vivo</span></div>
</div>
</div></section>

<section><div class="wrap">
<h2>Dónde <span class="hl">estamos</span></h2>
<p class="sub">Lo que vimos en su marca antes de proponer nada.</p>
<div class="grid c3">
<div class="card"><div class="ico"><svg viewBox="0 0 24 24"><path d="M5 12l5 5L20 7"/></svg></div><h3>Lo que sí funciona</h3><p>Marca personal reconocible, sitio web propio, el Método ADI para captar propiedades y más de 2 mil seguidores en Facebook.</p></div>
<div class="card"><div class="ico"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16v.5"/></svg></div><h3>Lo que falta</h3><p>Que cada publicación lleve a una acción medible. Y fotos y videos reales: Facebook ya marca algunas piezas como "Contenido de IA".</p></div>
<div class="card"><div class="ico"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M21 21l-5-5"/></svg></div><h3>Lo que no se sabe</h3><p>Cuántos mensajes de WhatsApp vienen de redes y qué propiedad genera más consultas. Medir eso es el primer arreglo.</p></div>
</div>
</div></section>

<section><div class="wrap">
<h2>Qué vamos a <span class="hl">probar</span></h2>
<p class="sub">Cinco posibles causas. Toque cada una para ver cómo se mide.</p>
<details><summary>1. Captar propietarios con el Método ADI</summary><p><b>Cómo se mide:</b> costo por propietario que escribe y cuántos firman exclusiva.</p></details>
<details><summary>2. Video real de la propiedad</summary><p><b>Cómo se mide:</b> costo por mensaje de video real frente a fotos con diseño.</p></details>
<details><summary>3. Renta contra venta</summary><p><b>Cómo se mide:</b> consultas y visitas agendadas por tipo de propiedad en Palín, Escuintla y la ciudad.</p></details>
<details><summary>4. Financiamiento y FHA como gancho</summary><p><b>Cómo se mide:</b> mensajes de compradores que preguntan si califican y cuántos pasan a visita.</p></details>
<details><summary>5. El rostro de Diana</summary><p><b>Cómo se mide:</b> mensajes y seguidores nuevos con Diana en cámara frente a solo propiedad.</p></details>
</div></section>

<section id="plan"><div class="wrap">
<h2>El plan en <span class="hl">3 fases</span></h2>
<p class="sub">Arranque: lunes 30 de noviembre de 2026.</p>
<div class="tl">
<div class="ph card"><small>Semanas 1 y 2 · 30 nov al 11 dic</small><h3>Diagnóstico</h3><p>Revisamos Facebook, Instagram y TikTok. Instalamos Pixel y etiquetas de WhatsApp, definimos cliente ideal y firmamos metas. Se publica la landing.</p></div>
<div class="ph card"><small>Semanas 3 a 8 · 14 dic al 24 ene</small><h3>Pruebas y contenido</h3><p>Lanzamos las 5 pruebas con anuncios, 3 videos por semana y seguimiento a cada mensaje. Optimizamos cada semana.</p></div>
<div class="ph card"><small>Semanas 9 a 12 · 25 ene al 20 feb</small><h3>Escalar o ajustar</h3><p>Subimos presupuesto a lo que funcionó, activamos remarketing y cerramos con informe final.</p></div>
</div>
</div></section>

<section><div class="wrap">
<h2>3 puntos de <span class="hl">decisión</span></h2>
<p class="sub">Usted decide. Todas las reuniones son en sábado a las 9:00 a. m.</p>
<div class="grid">
<div class="card dec"><div class="date"><b>12</b><span>DIC</span></div><div><h3>Decisión 1</h3><p>Resultado del diagnóstico, cliente ideal y metas firmadas.</p></div></div>
<div class="card dec"><div class="date"><b>23</b><span>ENE</span></div><div><h3>Decisión 2</h3><p>Con 8 semanas de datos: escalar o ajustar.</p></div></div>
<div class="card dec"><div class="date"><b>20</b><span>FEB</span></div><div><h3>Decisión 3</h3><p>Informe final: seguir, ajustar o cerrar la etapa.</p></div></div>
</div>
</div></section>

<section><div class="wrap">
<h2>Lo que verá cada <span class="hl">lunes</span></h2>
<p class="sub">Reporte de una página por WhatsApp a las 8:00 a. m., más el tablero de Looker Studio con cada quetzal en tiempo real.</p>
<div class="tags"><span>Costo por mensaje</span><span>Costo por prospecto calificado</span><span>Visitas agendadas</span><span>Propiedades con más consultas</span><span>Exclusivas captadas</span><span>Seguidores nuevos</span></div>
</div></section>

<section><div class="wrap">
<h2>Lo que necesitamos de <span class="hl">usted</span></h2>
<p class="sub">Para cumplir las fechas.</p>
<ul class="list" style="max-width:520px;margin:0 auto">
<li>Accesos a Facebook, Instagram, TikTok y Business Manager</li>
<li>Fotos y videos reales de las propiedades activas, con permiso de los dueños</li>
<li>Respuesta a cada mensaje de WhatsApp en menos de 15 minutos en horario de atención</li>
<li>Una llamada de 10 minutos cada semana para decirnos qué prospectos son buenos</li>
<li>Testimonios reales con nombre y autorización</li>
</ul>
</div></section>

<section id="precio"><div class="wrap">
<h2>Su <span class="hl">inversión</span></h2>
<p class="sub">Un solo paquete, el más completo, con precio especial si decide pronto.</p>
<div class="price">
<span class="flag">PRECIO ESPECIAL</span>
<h3>Premium · plan de 3 meses</h3>
<div class="old" id="old">Q8,500 al mes</div>
<div class="now" id="now">Q7,875<small> al mes</small></div>
<div class="cd" id="cd" role="timer" aria-live="off">
<div><b id="d">00</b><span>días</span></div><div><b id="h">00</b><span>horas</span></div><div><b id="m">00</b><span>min</span></div><div><b id="s">00</b><span>seg</span></div>
</div>
<p class="note" id="cdnote">Promoción por 3 meses, sin plan anual. Si decide trabajar con nosotros antes del viernes 27 de noviembre, le dejamos Q7,875 al mes: ahorra Q625 cada mes y Q1,875 en los 3 meses.</p>
<ul class="list">
<li>Anuncios en Meta y TikTok</li>
<li>Posts, carruseles y 3 videos por semana</li>
<li>Landing, Pixel y tablero en Looker Studio</li>
<li>Reporte semanal y llamada quincenal</li>
</ul>
<a class="btn" data-wa="Hola, quiero aprobar el Plan de Crecimiento 90 días de Diana Jaramillo con el precio de Q7,875" href="#">Aprobar por WhatsApp</a>
<p class="note">La inversión en anuncios va aparte y es la que Diana autoriza.</p>
</div>
</div></section>

<section class="final"><div class="wrap">
<h2>Empecemos el <span class="hl">lunes 30</span></h2>
<p class="sub">Apruebe y en 24 horas tiene el calendario y la lista de accesos.</p>
<a class="btn" data-wa="Hola, quiero empezar el lunes 30 con el plan de 90 días" href="#">Aprobar por WhatsApp</a>
</div></section>
</main>

<footer><div class="wrap">Bresco Media · Propuesta del 23 de noviembre de 2026.<br>Las fechas suponen arranque el lunes 30 de noviembre.</div></footer>

<script>
// Pon aquí el número de WhatsApp de Bresco, con código de país, por ejemplo "502XXXXXXXX"
var WA_NUMBER="";
document.querySelectorAll("[data-wa]").forEach(function(a){
  a.href="https://wa.me/"+WA_NUMBER+"?text="+encodeURIComponent(a.getAttribute("data-wa"));
  a.target="_blank";a.rel="noopener";
});
// Fin de la oferta: viernes 27 de noviembre de 2026, 11:59 p. m. (hora de Guatemala, UTC-6)
var END=new Date("2026-11-27T23:59:59-06:00").getTime();
function p(n){return String(n).padStart(2,"0")}
function tick(){
  var l=END-Date.now();
  if(l<=0){
    document.getElementById("cd").style.display="none";
    document.getElementById("old").style.display="none";
    document.getElementById("now").innerHTML="Q8,500<small> al mes</small>";
    document.getElementById("cdnote").textContent="El precio especial terminó. Escríbanos y vemos la mejor opción para usted.";
    clearInterval(t);return;
  }
  document.getElementById("d").textContent=p(Math.floor(l/864e5));
  document.getElementById("h").textContent=p(Math.floor(l%864e5/36e5));
  document.getElementById("m").textContent=p(Math.floor(l%36e5/6e4));
  document.getElementById("s").textContent=p(Math.floor(l%6e4/1e3));
}
var t=setInterval(tick,1000);tick();
</script>
</body>
</html>
